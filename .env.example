# Copy this file to .env, then set your own values.
GEMINI_API_KEY=

# "auto" prefers a stable /dev/v4l/by-id path on Linux and then /dev/video*.
# CAMERA_MATCH selects the external camera when several webcams are connected.
# Explicit examples: CAMERA_DEVICE=/dev/video4 or CAMERA_DEVICE=0 on Windows.
CAMERA_DEVICE=auto
<<<<<<< Updated upstream
CAMERA_MATCH=UGREEN
=======
CAMERA_MATCH=Jieli
>>>>>>> Stashed changes

# This project's YoloUNO currently appears at /dev/ttyACM0.
# Set this to "auto" to prefer /dev/serial/by-id and then probe ttyACM/ttyUSB
# candidates using the firmware PING/PONG handshake. Windows example: COM18.
SERIAL_PORT=auto
SERIAL_MATCH=Espressif
SERIAL_BAUD=115200

# Web dashboard and localhost-only ZMQ transport.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_LOG_LEVEL=info
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CONVEYOR_COMMAND_ENDPOINT=tcp://127.0.0.1:5555
CONVEYOR_EVENT_ENDPOINT=tcp://127.0.0.1:5556
CONVEYOR_FRAME_ENDPOINT=tcp://127.0.0.1:5557

# Linear axis (TB6600 + 57BYG250D-8 lead screw, firmware 3200 steps/s).
# BELT_LENGTH_CM = physical distance between the calibrated left and right edges.
# SPEED_TEST_*: run `python serial_test.py /dev/ttyACM0 RIGHT 3000`, measure the
# carriage travel in cm -> SPEED_TEST_DISTANCE_CM, and 3.0 -> SPEED_TEST_TIME_S.
BELT_LENGTH_CM=35
SPEED_TEST_DISTANCE_CM=4.8
SPEED_TEST_TIME_S=3.0
TARGET_TOLERANCE_CM=1.0
NEAR_TARGET_CM=3.0
NEAR_TARGET_MAX_MS=600
# Must stay <= firmware MAX_DURATION_MS (10000).
MAX_MOVE_MS=6000
TARGET_HINT=This setup is a lead-screw linear axis, not a belt. The object to track is the black bench-vise carriage that slides along the rail; report the center of the vise as the object point. Treat it as the movable object even though it is mounted on the rail.
